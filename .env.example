# Path to Google Cloud Service Account JSON key file
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional target Google Drive folder ID (leave empty for My Drive root)
GDRIVE_FOLDER_ID=

# Upload chunk size in megabytes (multiples of 256 KB recommended by Google API, default 10MB)
CHUNK_SIZE_MB=10

# RapidAPI YouTube Downloader credentials
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=your_rapidapi_host_here
RAPIDAPI_URL=https://your-chosen-api.p.rapidapi.com/dl

